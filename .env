# Copy this file to .env.local (gitignored) to override the committed .env default
# without touching version control, e.g. for a staging or production API URL.
EXPO_PUBLIC_API_BASE=https://api.scancode.ng/

# Sentry DSN for crash reporting (src/utils/crashReporting.ts). A DSN is not secret — it's
# designed to be embedded in client code — but it's left unset here so local dev builds
# don't report to a real project. Leaving this unset disables Sentry entirely.
EXPO_PUBLIC_SENTRY_DSN=

# SENTRY_AUTH_TOKEN is a real secret (unlike the DSN above) used only at build time to
# upload source maps — set it in .env.local or your CI/EAS secrets, never commit it, and
# never prefix it with EXPO_PUBLIC_ (that would bundle it into the client).
SENTRY_AUTH_TOKEN=
