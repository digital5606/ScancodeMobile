{
  "expo": {
    "name": "ScanCode-React-Native",
    "slug": "scancode-mobile",
    "version": "1.0.0",
    "scheme": "scancode",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.idcode.scancode",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.idcode.scancode",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-web-browser",
      "expo-secure-store",
      "expo-audio",
      "expo-notifications",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "ScanCode uses your location to show storefronts near you in the Discover directory."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "ScanCode uses your camera to scan a table's QR code."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "ScanCode uses your photo library so you can upload a storefront logo, images, or product photos.",
          "cameraPermission": false
        }
      ],
      "expo-asset"
    ]
  }
}
